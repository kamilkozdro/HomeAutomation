<TcPlcObject Version="1.1.0.1">
  <DUT Name="ShutterCommandType" Id="{23be3c58-230f-4a45-8a04-cf15dcfe10a1}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE ShutterCommandType :
(
    NONE,           // No command
    OPEN,           // Open command (move to 100%)
    CLOSE,          // Close command (move to 0%)
    STOP,           // Stop command
    MOVE_TO_POSITION // Move to specific position
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>