<TcPlcObject Version="1.1.0.1">
  <DUT Name="stShutterConfig" Id="{cba03735-b58c-4ca0-9c02-4878db374737}">
    <Declaration><![CDATA[TYPE stShutterConfig :
STRUCT
    UpOutput   : BOOL;                // Relay control for upward movement
    DownOutput : BOOL;                // Relay control for downward movement
    
    TravelTime : TIME := T#30s;       // Time for full open/close movement [0-100%]
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
