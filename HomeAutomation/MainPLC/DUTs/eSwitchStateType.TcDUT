  <DUT Name="eSwitchStateType" Id="{d36e16d9-ce68-4029-8826-9fad28d146b6}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE eSwitchStateType :
(
    IDLE,            // Idle - no action
    SHORT_CLICK,     // Short click
    LONG_CLICK,      // Long click
    HOLD,            // Hold
    MULTI_CLICK      // Multiple click
);
END_TYPE
]]></Declaration>
