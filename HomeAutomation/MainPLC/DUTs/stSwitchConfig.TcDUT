<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="stSwitchConfig" Id="{5812c89a-38d9-4c5f-8ce2-7bfe653b25eb}">
    <Declaration><![CDATA[TYPE stSwitchConfig :
STRUCT
    // Basic parameters
    Input       : BOOL;                
    
    // Click timing parameters
    ShortClickMaxTime   : TIME := T#300ms;     // Max time for short click
    ShortClickDelayTime : TIME := T#300MS;     // Max time between short clicks
    LongClickMaxTime    : TIME := T#1000MS;    // Max time for long click
    
    (* Time logic:
        ShortClick < ShortClickMaxTime
        ShortClickMaxTime < LongClick < LongClickMaxTime  
        LongClickMaxTime < Hold
    *)
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>