<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="stShutterState" Id="{777aa08a-edfb-4ead-b67a-bc47756d0cde}">
    <Declaration><![CDATA[TYPE stShutterState :
STRUCT
    CurrentState    : eShutterStateType;        // Current shutter state
    PreviousState   : eShutterStateType;        // Previous state
    StateChanged    : BOOL;                // State change flag
    
    CurrentPosition : USINT := 0;          // Current position [%] (0=closed, 100=open)
	CurrentAngle : USINT := 0;				// Current angle [%] (0=closed, 100=open)
    TargetPosition  : USINT := 0;          // Target position [%]
    SavedPosition   : USINT := 50;         // Saved position for memory function
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>