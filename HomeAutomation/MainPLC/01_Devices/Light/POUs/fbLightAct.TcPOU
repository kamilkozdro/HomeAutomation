<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fbLightAct" Id="{b3771d91-f85a-45c2-be56-d9716500abad}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK fbLightAct
VAR_INPUT
	ControlState : stLightState;
END_VAR
VAR_OUTPUT
	CurrentState : stLightState;
	PowerOnOut : BOOL;
	BrightnessOut : REAL;
END_VAR
VAR
	Brightness : USINT := 0;
END_VAR
VAR CONSTANT
	BrightnessMin : USINT := 0;
	BrightnessMax : USINT := 100;
	BrightnessOutMin : REAL := 0.0;
	BrightnessOutMax : REAL := 10.0;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[PowerOnOut := ControlState.PowerOn;

Brightness := LIMIT(BrightnessMin, ControlState.Brightness, BrightnessMax);
BrightnessOut := Brightness * (BrightnessOutMax - BrightnessOutMin) / (BrightnessMax - BrightnessMin) + BrightnessOutMin;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>