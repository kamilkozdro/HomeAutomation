    <Property Name="IsOn" Id="{fdf1f5c0-1d34-44d9-9a3c-98aeec8ce493}">
      <Declaration><![CDATA[{warning 'Add property implementation'}
PROPERTY IsOn : BOOL
]]></Declaration>
      <Get Name="Get" Id="{4d9809c0-2f84-495f-af80-3b10be486202}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsOn := LightRelay.IsSet;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{0dff9594-ad36-443b-9a85-7e97544acc5e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF IsOn THEN
	LightRelay.Set();
ELSE
	LightRelay.Reset();
END_IF]]></ST>
        </Implementation>
      </Set>
    </Property>
