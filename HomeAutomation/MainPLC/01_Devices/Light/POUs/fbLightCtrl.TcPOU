<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fbLightCtrl" Id="{f48d238b-7380-457c-b942-fe12e57d6263}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK fbLightCtrl

VAR_INPUT
	CurrentState : stLightState;
	Config : stLightConfig;
END_VAR
VAR_OUTPUT
	ControlState : stLightState := CleanState;
END_VAR
VAR_IN_OUT
	CmdEvent : stLightCmdEvent;
END_VAR
VAR
	TargetState : stLightState := CleanState;
    BrightnessRampTarget  : USINT := BrightnessMin;
    BrightnessStep : USINT := 0;
END_VAR
VAR CONSTANT
    CycleTime : TIME := T#50MS;
	BrightnessMin : USINT := 0;
	BrightnessMax : USINT := 100;
	CleanState : stLightState := (
        PowerOn := FALSE,
        Color := (Red := 255, Green := 255, Blue := 255),
        Temperature := eLightTemperature.NEUTRAL,
        Brightness := 0 );
	CleanCmdEvent : stLightCmdEvent := (
		Execute := FALSE,
		TargetState := CleanState,
		Source := eLightCmdSource.NONE);
END_VAR
VAR RETAIN
	SavedState : stLightState := CleanState;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// Execute commands only if light is turned ON
IF CmdEvent.Execute THEN
	TargetState := CmdEvent.TargetState;
	TargetState.Brightness := LIMIT(BrightnessMin, CmdEvent.TargetState.Brightness, BrightnessMax);
	IF CmdEvent.TargetState.PowerOn THEN
		TargetState := SavedState;
	ELSE
		SavedState :=  CmdEvent.TargetState;
	END_IF
END_IF

// Turn on light
IF TargetState.PowerOn THEN
	ControlState.PowerOn := TRUE;
// Turn off light
ELSE
	//TargetState.Brightness := BrightnessMin;
	IF ControlState.Brightness = BrightnessMin THEN
		ControlState.PowerOn := FALSE;
	ELSE
		ControlState.PowerOn := TRUE;
	END_IF
END_IF

// Change Brightness


	// If Config.BrightnessRamp is NOT active
	// Change brightness immediately
IF NOT Config.BrightnessRamp THEN
	ControlState.Brightness := TargetState.Brightness;
ELSIF Config.BrightnessRampTime <= CycleTime THEN
	ControlState.Brightness := TargetState.Brightness;
	// If Config.BrightnessRamp is active
	// Increment/decrement brightness each CycleTime untill TargetState.Brightness is reached
ELSE
	BrightnessStep := UDINT_TO_USINT(BrightnessMax * TIME_TO_UDINT(CycleTime) / TIME_TO_UDINT(Config.BrightnessRampTime));
	IF ControlState.Brightness < TargetState.Brightness THEN
		ControlState.Brightness := MIN(ControlState.Brightness + BrightnessStep, 
								TargetState.Brightness);
	ELSIF ControlState.Brightness > TargetState.Brightness THEN
		ControlState.Brightness := MAX(ControlState.Brightness - BrightnessStep, 
								TargetState.Brightness);
	END_IF
END_IF

// Change Temperature
ControlState.Temperature := TargetState.Temperature;

// Change Color
ControlState.Color.Blue := TargetState.Color.Blue;
ControlState.Color.Red := TargetState.Color.Red;
ControlState.Color.Green := TargetState.Color.Green;

CmdEvent := CleanCmdEvent;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>