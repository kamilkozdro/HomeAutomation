<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fbShutterCmdSourceHa" Id="{bea2cbb9-d6f5-424c-a4c2-d3e45d744a98}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK fbShutterCmdSourceHa IMPLEMENTS iShutterCmdSource
VAR_IN_OUT
	HaCmdEvent : stShutterCmdEvent;
END_VAR
VAR
	HaCmdCache : stShutterCmdEvent;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[HaCmdCache := HaCmdEvent;

IF HaCmdEvent.Execute THEN
	HaCmdEvent.Execute := FALSE;
END_IF

]]></ST>
    </Implementation>
    <Method Name="Process" Id="{577ae5fb-79da-4adc-9275-af801257441c}">
      <Declaration><![CDATA[METHOD Process
VAR_IN_OUT
	CmdEvent	: stShutterCmdEvent;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF HaCmdCache.Execute THEN
	CmdEvent := HaCmdCache;
	CmdEvent.Source := eShutterCmdSource.HA;
	HaCmdCache.Execute := FALSE;
END_IF

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>