<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fbShutterCmdSourceSwitch" Id="{c862dcf9-c651-483d-a78a-0c62d3a73fd7}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK fbShutterCmdSourceSwitch IMPLEMENTS iShutterCmdSource
VAR_INPUT
    OpenSwitchState : stSwitchState;
    CloseSwitchState : stSwitchState;
    ShutterStateType : eShutterStateType;
END_VAR
VAR PERSISTENT
    OpenLongClickPosition : stShutterPosition := (Height := 50, Angle := 100);
    CloseLongClickPosition : stShutterPosition := (Height := 0, Angle := 100);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="FB_Init" Id="{fff114ce-5fd2-46ef-8f18-76cafa481a71}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.
//The return value is not evaluated. For a specific influence, you can also declare the
//methods explicitly and provide additional code there with the standard initialization
//code. You can evaluate the return value.
METHOD FB_Init: BOOL
VAR_INPUT
    bInitRetains: BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
    bInCopyCode: BOOL;  // TRUE: the instance will be copied to the copy code afterward (online change)  
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="Process" Id="{bb7c2f45-924d-4762-a2d7-89765f3d0a73}">
      <Declaration><![CDATA[METHOD Process
VAR_IN_OUT
	CmdEvent : stShutterCmdEvent;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// Exit if both switches are idle
IF OpenSwitchState.StateType = eSwitchStateType.IDLE AND
   CloseSwitchState.StateType = eSwitchStateType.IDLE THEN
    RETURN;
END_IF

// If shutter is moving and any switch was pressed
IF ShutterStateType <> eShutterStateType.IDLE THEN
    CmdEvent.Cmd.CmdType := eShutterCmdType.STOP;
// Double Open click
ELSIF (OpenSwitchState.StateType = eSwitchStateType.MULTI_CLICK) AND (OpenSwitchState.PressCount = 2) THEN
    CmdEvent.Cmd.CmdType := eShutterCmdType.OPEN;
// Double Close click
ELSIF (CloseSwitchState.StateType = eSwitchStateType.MULTI_CLICK) AND (CloseSwitchState.PressCount = 2) THEN
    CmdEvent.Cmd.CmdType := eShutterCmdType.CLOSE;
// Short Open click
ELSIF OpenSwitchState.StateType = eSwitchStateType.SHORT_CLICK THEN
    CmdEvent.Cmd.CmdType := eShutterCmdType.STEP_OPEN;
// Short Close click
ELSIF CloseSwitchState.StateType = eSwitchStateType.SHORT_CLICK THEN
    CmdEvent.Cmd.CmdType := eShutterCmdType.STEP_CLOSE;
// Long Open click
ELSIF OpenSwitchState.StateType = eSwitchStateType.LONG_CLICK THEN
    CmdEvent.Cmd.CmdType := eShutterCmdType.MOVE_TO_POSITION;
    CmdEvent.Cmd.Position := OpenLongClickPosition;
// Long Close click
ELSIF CloseSwitchState.StateType = eSwitchStateType.LONG_CLICK THEN
    CmdEvent.Cmd.CmdType := eShutterCmdType.MOVE_TO_POSITION;
    CmdEvent.Cmd.Position := CloseLongClickPosition;
END_IF

CmdEvent.Execute := TRUE;
CmdEvent.Source := eShutterCmdSource.SWITCH;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>