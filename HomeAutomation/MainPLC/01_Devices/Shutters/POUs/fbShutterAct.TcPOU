<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fbShutterAct" Id="{1ba23f45-b0eb-421e-9a3b-6a879c5afe8f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK fbShutterAct
VAR

	OpenRelay : iRelay;
	CloseRelay : iRelay;
	
	CmdOpen : BOOL;
	CmdClose : BOOL;
	
	Config : stShutterConfig;
	
	OutputCheckTimer : TON;
END_VAR
VAR_OUTPUT
	Position : stShutterPosition;
	StateType : eShutterStateType;
END_VAR
VAR CONSTANT
	OutputCheckCycleTime: TIME := T#50MS;
END_VAR
VAR PERSISTENT
	HeightTime: TIME := T#0S;
	AngleTime: TIME := T#0S;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// Both signals must not be set at the same time
IF CmdOpen AND CmdClose THEN
	CmdOpen := FALSE;
	CmdClose := FALSE;
END_IF

// Reset signal if shutter reached fully open position with overstep
IF CmdOpen AND HeightTime >= Config.HeightTravelTime + Config.HeightTravelTimeOverstep THEN
	CmdOpen := FALSE;
END_IF

// Reset signal if shutter reached fully close position
IF CmdClose AND HeightTime <= T#0S THEN
	CmdClose := FALSE;
END_IF

// Write physical outputs and update shutter state
IF CmdOpen AND NOT CmdClose THEN
    CloseRelay.Reset();
    OpenRelay.Set();
	StateType := eShutterStateType.MOVING_UP;
ELSIF CmdClose AND NOT CmdOpen THEN
    OpenRelay.Reset();
    CloseRelay.Set();
	StateType := eShutterStateType.MOVING_DOWN;
ELSE
    OpenRelay.Reset();
    CloseRelay.Reset();
	StateType := eShutterStateType.IDLE;
END_IF

// Count time and accumulate when signals are set
OutputCheckTimer(IN := CmdOpen OR CmdClose, PT := OutputCheckCycleTime);
IF OutputCheckTimer.Q THEN
	IF CmdOpen THEN
		// Open fins first before moving up
		IF AngleTime < Config.AngleTravelTime THEN
			AngleTime := AngleTime + OutputCheckCycleTime;
		ELSIF HeightTime < Config.HeightTravelTime THEN
			HeightTime := HeightTime + OutputCheckCycleTime;
		END_IF;
	END_IF
	
	IF CmdClose THEN
		// Close fins first before moving down
		IF AngleTime > T#0S THEN
			AngleTime := AngleTime - OutputCheckCycleTime;
		ELSIF HeightTime > T#0s THEN
			HeightTime := HeightTime - OutputCheckCycleTime;
		END_IF;
	END_IF
	
	OutputCheckTimer.IN := FALSE;  // reset
END_IF

// Update shutter position% basen on position time
Position.Height := TimeToPosition(CurrentPosTime := HeightTime, TravelTime := Config.HeightTravelTime);
Position.Angle := TimeToPosition(CurrentPosTime := AngleTime, TravelTime := Config.AngleTravelTime);

]]></ST>
    </Implementation>
    <Method Name="Close" Id="{f613d1a9-dcd5-4ce8-bd35-546352718445}">
      <Declaration><![CDATA[METHOD Close
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CmdOpen := FALSE;
CmdClose := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Init" Id="{f4ce97e9-a5c2-452b-b73c-23b84716f67a}">
      <Declaration><![CDATA[METHOD Init
VAR_INPUT
	OpenRelay : iRelay;
	CloseRelay : iRelay;
	Config : stShutterConfig;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.Config := Config;
THIS^.OpenRelay := OpenRelay;
THIS^.CloseRelay := CloseRelay;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Open" Id="{1dda91e8-cd15-4a31-9096-5e1a4c5f89a9}">
      <Declaration><![CDATA[METHOD Open
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CmdClose := FALSE;
CmdOpen := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stop" Id="{17cc93a3-e742-4197-a775-db53f236a55d}">
      <Declaration><![CDATA[METHOD Stop
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CmdOpen := FALSE;
CmdClose := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TimeToPosition" Id="{772cedc8-24ef-4e71-897a-f0415c3ffac2}">
      <Declaration><![CDATA[METHOD PUBLIC TimeToPosition : USINT
VAR_INPUT
	CurrentPosTime : TIME;
	TravelTime : TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TravelTime <= T#0S THEN
    TimeToPosition := 0;
ELSE
    TimeToPosition := UDINT_TO_USINT(100 * TIME_TO_UDINT(CurrentPosTime) / TIME_TO_UDINT(TravelTime));
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>