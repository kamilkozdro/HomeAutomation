<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fbMonoSwitch" Id="{21737aef-df48-4987-83e0-aae9b7cbc7ab}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK PUBLIC fbMonoSwitch IMPLEMENTS iSwitch
VAR
	Input AT %I* : BOOL;					// Physical switch input
	
	SwitchPressed : R_TRIG;
	SwitchReleased : F_Trig;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SwitchPressed(CLK := Input);
SwitchReleased(CLK := Input);]]></ST>
    </Implementation>
    <Property Name="IsPressed" Id="{238fedb4-7f31-449e-bffb-88405f0e3fe6}">
      <Declaration><![CDATA[PROPERTY PUBLIC IsPressed : BOOL]]></Declaration>
      <Get Name="Get" Id="{bc4b2b4d-b425-4031-ada5-782516be3c69}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsPressed := SwitchPressed.Q;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsReleased" Id="{f2e12f74-1423-4b11-9d68-63053027c6bb}">
      <Declaration><![CDATA[PROPERTY IsReleased : BOOL]]></Declaration>
      <Get Name="Get" Id="{00b0c95b-d4ed-4500-978f-f246b06ade20}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsReleased := SwitchReleased.Q;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>