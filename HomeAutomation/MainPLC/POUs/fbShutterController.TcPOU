<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fbShutterController" Id="{f0ca0ac4-2fc3-4b9b-9b38-c97d3aa4583e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK PUBLIC fbShutterController
VAR_INPUT
    Command : stShutterCommand;        // Command input
	State   : stShutterState;
END_VAR
VAR_OUTPUT
    MoveUp : BOOL;
	MoveDown : BOOL;
END_VAR
VAR
	MovingToPosition : BOOL := FALSE;
	TargetPosition : USINT := 0;
	TargetAngle : USINT := 0;
END_VAR
VAR CONSTANT
	Hysteresis: USINT := 1;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// Handle commands
CASE Command.CommandType OF
    eShutterCommandType.STOP:
		MovingToPosition := FALSE;
        MoveUp := FALSE;
        MoveDown := FALSE;
		
	eShutterCommandType.OPEN:
		MovingToPosition := FALSE;
        MoveUp := TRUE;
        MoveDown := FALSE;
	
	eShutterCommandType.CLOSE:
		MovingToPosition := FALSE;
        MoveUp := FALSE;
        MoveDown := TRUE;
		
	eShutterCommandType.MOVE_TO_POSITION:
		MovingToPosition := TRUE;
		TargetPosition := Command.Position;
		TargetAngle := Command.Angle;
		
    eShutterCommandType.NONE:
        // No command
END_CASE;

IF MovingToPosition THEN	
	// Move to target vertical position first
	IF State.CurrentPosition < TargetPosition THEN
		MoveUp := TRUE;
		MoveDown := FALSE;
	ELSIF State.CurrentPosition > TargetPosition THEN
		MoveUp := FALSE;
		MoveDown := TRUE;
	ELSE
		// Then move to target angle
		IF State.CurrentAngle < TargetAngle THEN
			MoveUp := TRUE;
			MoveDown := FALSE;
		ELSIF State.CurrentAngle > TargetAngle THEN
			MoveUp := FALSE;
			MoveDown := TRUE;
		ELSE
			// Target Position and Angle achieved
			MovingToPosition := FALSE;
			MoveUp := FALSE;
			MoveDown := FALSE;
		END_IF
	END_IF
END_IF

]]></ST>
    </Implementation>
    <Method Name="PositionToTime" Id="{dbc29192-5de4-4308-8606-585b4f317150}">
      <Declaration><![CDATA[METHOD PUBLIC PositionToTime : TIME
VAR_INPUT
	Position : USINT;
	TravelTime : TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[PositionToTime := UDINT_TO_TIME(USINT_TO_UDINT(Position) * TIME_TO_UDINT(TravelTime) / 100);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TimeToPosition" Id="{efd8e2c9-8d96-4b41-9e35-c0880f0a2526}">
      <Declaration><![CDATA[METHOD PUBLIC TimeToPosition : USINT
VAR_INPUT
	PositionTime : TIME;
	TravelTime : TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TimeToPosition := UDINT_TO_USINT(100 * TIME_TO_UDINT(PositionTime) / TIME_TO_UDINT(TravelTime)); 
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>