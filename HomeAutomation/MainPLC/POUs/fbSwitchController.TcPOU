<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fbSwitchController" Id="{6dccb3b9-fb1e-43bd-90e9-b21e728438a7}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK PUBLIC fbSwitchController
VAR_INPUT
    Config : stSwitchConfig;                     // Switch configuration
END_VAR
VAR_OUTPUT
    State : stSwitchState;                   // Processed switch state
END_VAR
VAR
    // Beckhoff edge detection
    SwitchPressed : R_TRIG;                          // Rising edge detector
    SwitchReleased : F_TRIG;                          // Falling edge detector
    PressTimerQRise : R_TRIG;
	PressTimerQFall : F_TRIG;
    // Timers
    PressTimer : TON;                         // Press duration timer
    MultiClickTimer : TON;                    // Multi-click timer
    
    // Internal
    PressCount : USINT := 0;                  // Click counter
	PressTime : TIME := T#0MS;
	ClickType : eSwitchStateType := eSwitchStateType.IDLE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* 
-----------------------------
fbSwitchController:
Set State output based on Config.Input.
State persist per one PLC cycle, except IDLE, which is a default state.
Every state change sets State.StateChanged to TRUE for one PLC cycle.

SHORT_CLICK <= Config.ShortClickMaxTime
Config.ShortClickMaxTime < LONG_CLICK < Config.LongClickMaxTime
Config.LongClickMaxTime <= HOLD
MULTI_CLICK is multiple SHORT_CLICKs delayed from one another < Config.ShortClickDelayTime
State.PressCount hold amount of switch releases for MULTI_CLICK
-----------------------------
*)

ClickType := eSwitchStateType.IDLE;
State.StateChanged := FALSE;
SwitchPressed(CLK := Config.Input);
SwitchReleased(CLK := Config.Input);
PressTimerQRise(CLK := Config.Input);
PressTimerQFall(CLK := Config.Input);

IF SwitchPressed.Q THEN
    PressTimer(IN := TRUE, PT := Config.LongClickMaxTime);

END_IF

PressTimer();
MultiClickTimer();

IF SwitchReleased.Q THEN
	PressTime := PressTimer.ET;
	PressTimer(IN := FALSE);
	PressCount := PressCount + 1;
	MultiClickTimer(IN := FALSE);
	
	// Short click
	IF(PressTime <= Config.ShortClickMaxTime) THEN
		MultiClickTimer(IN := TRUE, PT := Config.ShortClickDelayTime);
	// Long click	
	ELSIF (PressTime < Config.LongClickMaxTime) THEN
		ClickType := eSwitchStateType.LONG_CLICK;
	// NOTE: if PressTime = Config.LongClickMaxTime, after HOLD release next state became LONG_CLICK instead of IDLE
	END_IF
END_IF

// Hold click
IF PressTimerQRise.Q THEN
    ClickType := eSwitchStateType.HOLD_ON;
END_IF

IF PressTimerQFall.Q THEN
    ClickType := eSwitchStateType.HOLD_OFF;
END_IF

IF MultiClickTimer.Q AND NOT Config.Input THEN
	IF PressCount > 1 THEN
		 ClickType := eSwitchStateType.MULTI_CLICK;
	ELSE
		ClickType := eSwitchStateType.SHORT_CLICK;
	END_IF
	MultiClickTimer(IN := FALSE);
END_IF

IF ClickType <> State.CurrentState THEN
	State.PreviousState := State.CurrentState;
	State.CurrentState := ClickType;
	State.PressCount := PressCount;
	State.StateChanged := TRUE;
	
	PressCount := 0;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>