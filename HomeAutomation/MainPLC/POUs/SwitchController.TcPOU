<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="SwitchController" Id="{e5dc1c87-f12a-49b0-abc3-d2006b1b7420}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK PUBLIC SwitchController
VAR_INPUT
    Config : SwitchConfig;                     // Switch configuration
END_VAR
VAR_OUTPUT
    State : SwitchStateData;                   // Processed switch state
END_VAR
VAR
    // Beckhoff edge detection
    R_Trig : R_TRIG;                          // Rising edge detector
    F_Trig : F_TRIG;                          // Falling edge detector
    
    // Timers
    PressTimer : TON;                         // Press duration timer
    ClickTimer : TON;                         // Multi-click timer
    
    // Internal
    PressCount : USINT := 0;                  // Click counter
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// Edge detection
R_Trig(CLK := Config.Input);
F_Trig(CLK := Config.Input);

// Store previous state
State.PreviousState := State.CurrentState;

// Handle button press (rising edge)
IF R_Trig.Q THEN
    // Start timing the press
    PressTimer(IN := TRUE, PT := Config.LongClickMaxTime);
    
    // Count this press
    PressCount := PressCount + 1;
    
    // Reset and start multi-click timer
    ClickTimer(IN := FALSE);
    ClickTimer(IN := TRUE, PT := Config.ShortClickDelayTime);
END_IF

// Handle button release (falling edge)
IF F_Trig.Q THEN
    // Stop press timer
    PressTimer(IN := FALSE);
    
    // Determine click type based on duration
    IF PressTimer.ET <= Config.ShortClickMaxTime THEN
        // Short click
        State.CurrentState := SwitchState.SHORT_CLICK;
        State.PressCount := PressCount;
        State.TotalPresses := State.TotalPresses + 1;
        
    ELSIF PressTimer.ET <= Config.LongClickMaxTime THEN
        // Long click
        State.CurrentState := SwitchState.LONG_CLICK;
        State.PressCount := PressCount;
        State.TotalPresses := State.TotalPresses + 1;
        
    END_IF
    
    State.StateChanged := TRUE;
END_IF

// Handle hold (still pressed after LongClickMaxTime)
IF Config.Input AND PressTimer.Q THEN
    State.CurrentState := SwitchState.HOLD;
    State.StateChanged := TRUE;
    
    // Reset for multi-click
    PressCount := 0;
END_IF

// Handle multi-click (timer expired after last release)
IF NOT Config.Input AND ClickTimer.Q AND (PressCount > 1) THEN
    State.CurrentState := SwitchState.MULTI_CLICK;
    State.PressCount := PressCount;
    State.TotalPresses := State.TotalPresses + 1;
    State.StateChanged := TRUE;
    
    PressCount := 0;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>