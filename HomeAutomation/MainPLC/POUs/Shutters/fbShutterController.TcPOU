<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fbShutterController" Id="{f0ca0ac4-2fc3-4b9b-9b38-c97d3aa4583e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK PUBLIC fbShutterController
VAR_INPUT
    Command : stShutterCommand;			// Command input (one-shot or const)
	State   : stShutterState;			// Shutter state from fbShutterActuator output
END_VAR
VAR_OUTPUT
    MoveUp : BOOL;						// Signal for fbShutterActuator input
	MoveDown : BOOL;					// Signal for fbShutterActuator input
END_VAR
VAR
	CurrentCommand : stShutterCommand;
	CommandChanged : BOOL := FALSE;
	MovingToPosition : BOOL := FALSE;
	TargetPosition : USINT := 0;
	TargetAngle : USINT := 0;
END_VAR
VAR CONSTANT
	Hysteresis: USINT := 1;
	MoveStep : USINT := 10;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* 
	Shutter Controller Function Block
	
	100 - fully open position/angle
	0 - fully close position/angle

*)


// Check for new command
CommandChanged := Command.CommandType <> CurrentCommand.CommandType
					OR Command.Position <> CurrentCommand.Position
					OR Command.Angle <> CurrentCommand.Angle;
					
// Handle new command
IF CommandChanged THEN
	CurrentCommand := Command;
	CASE Command.CommandType OF
		eShutterCommandType.STOP:
			MovingToPosition := FALSE;
			MoveUp := FALSE;
			MoveDown := FALSE;
			
		eShutterCommandType.OPEN:
			MovingToPosition := TRUE;
			TargetPosition := 100;
			TargetAngle := 100;
		
		eShutterCommandType.CLOSE:
			MovingToPosition := TRUE;
			TargetPosition := 0;
			TargetAngle := 0;
			
		eShutterCommandType.STEP_OPEN:
			MovingToPosition := TRUE;
			TargetPosition := State.CurrentPosition;
			// First open fins by angle step
			IF State.CurrentAngle <= 100 - MoveStep THEN
				TargetAngle := State.CurrentAngle + MoveStep;
			// If fins are fully open -> move position
			ELSE
				TargetAngle := 100;
				IF State.CurrentPosition < 100 - MoveStep THEN
					TargetPosition := State.CurrentPosition + MoveStep;
				ELSE
					TargetPosition := 100;
				END_IF
			END_IF
			//TargetPosition := State.CurrentPosition + MoveStep;
			//TargetAngle := 0;
			
		eShutterCommandType.STEP_CLOSE:
			MovingToPosition := TRUE;
			TargetPosition := State.CurrentPosition;
			// First close fins by angle step
			IF State.CurrentAngle >= 0 + MoveStep THEN
				TargetAngle := State.CurrentAngle - MoveStep;
			// If fins are fully closed -> move position
			ELSE
				TargetAngle := 0;
				IF State.CurrentPosition >= 0 + MoveStep THEN
					TargetPosition := State.CurrentPosition - MoveStep;
				ELSE
					TargetPosition := 0;
				END_IF
			END_IF
			
		eShutterCommandType.MOVE_TO_POSITION:
			MovingToPosition := TRUE;
			TargetPosition := Command.Position;
			TargetAngle := Command.Angle;
			
		eShutterCommandType.NONE:
			// No command
	END_CASE;
END_IF

IF MovingToPosition THEN	
	// Move to target vertical position first
	IF State.CurrentPosition < TargetPosition THEN
		MoveUp := TRUE;
		MoveDown := FALSE;
	ELSIF State.CurrentPosition > TargetPosition THEN
		MoveUp := FALSE;
		MoveDown := TRUE;
	ELSE
		// Then move to target angle
		IF State.CurrentAngle < TargetAngle THEN
			MoveUp := TRUE;
			MoveDown := FALSE;
		ELSIF State.CurrentAngle > TargetAngle THEN
			MoveUp := FALSE;
			MoveDown := TRUE;
		ELSE
			// Target Position and Angle achieved
			MovingToPosition := FALSE;
			MoveUp := FALSE;
			MoveDown := FALSE;
		END_IF
	END_IF
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>