<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fbShutterCtrl" Id="{f0ca0ac4-2fc3-4b9b-9b38-c97d3aa4583e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK fbShutterCtrl
VAR
	ShutterAct : fbShutterAct;
	NewCommandSet : BOOL := FALSE;
	MovingToPosition : BOOL := FALSE;
	TargetPosition : stShutterPosition;
END_VAR
VAR CONSTANT
	Hysteresis: USINT := 1;
	MoveStep : USINT := 10;
END_VAR
VAR_OUTPUT
	// Commands exposed as read only in OUTPUT and not as Property.Get
	// TwinCAT doesn't allow access to copied structure members in Property.Get, only when passed by REF (Not read only). 
	// Couldn't do ShutterCtrl.CurrentCommand.Position.Height if CurrentCommand was a Property
	CurrentCommand : stShutterCommand;
	PreviousCommand : stShutterCommand;
	CurrentPosition : stShutterPosition;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* 
	Shutter Controller Function Block
	
	100 - fully open position/angle
	0 - fully close position/angle

*)
					
// Handle new command
IF NewCommandSet THEN
	NewCommandSet := FALSE;
	CASE CurrentCommand.CommandType OF
		eShutterCommandType.STOP:
			MovingToPosition := FALSE;
			ShutterAct.Stop();
			
		eShutterCommandType.OPEN:
			MovingToPosition := TRUE;
			TargetPosition.Height := 100;
			TargetPosition.Angle := 100;
		
		eShutterCommandType.CLOSE:
			MovingToPosition := TRUE;
			TargetPosition.Height := 0;
			TargetPosition.Angle := 0;
			
		eShutterCommandType.STEP_OPEN:
			MovingToPosition := TRUE;
			TargetPosition := ShutterAct.Position;
			// First open fins by angle step
			IF ShutterAct.Position.Angle <= 100 - MoveStep THEN
				TargetPosition.Angle := ShutterAct.Position.Angle + MoveStep;
			// If fins are fully open -> move position
			ELSE
				TargetPosition.Angle := 100;
				IF ShutterAct.Position.Height < 100 - MoveStep THEN
					TargetPosition.Height := ShutterAct.Position.Height + MoveStep;
				ELSE
					TargetPosition.Height := 100;
				END_IF
			END_IF
			
		eShutterCommandType.STEP_CLOSE:
			MovingToPosition := TRUE;
			TargetPosition := ShutterAct.Position;
			// First close fins by angle step
			IF ShutterAct.Position.Angle >= 0 + MoveStep THEN
				TargetPosition.Angle := ShutterAct.Position.Angle - MoveStep;
			// If fins are fully closed -> move position
			ELSE
				TargetPosition.Angle := 0;
				IF ShutterAct.Position.Height >= 0 + MoveStep THEN
					TargetPosition.Height := ShutterAct.Position.Height - MoveStep;
				ELSE
					TargetPosition.Height := 0;
				END_IF
			END_IF
			
		eShutterCommandType.MOVE_TO_POSITION:
			MovingToPosition := TRUE;
			TargetPosition := CurrentCommand.Position;
			
		eShutterCommandType.NONE:
			// No command
	END_CASE;
END_IF

IF MovingToPosition THEN	
	// Move to target vertical position first
	IF ShutterAct.Position.Height + Hysteresis < TargetPosition.Height THEN
		ShutterAct.Open();
	ELSIF ShutterAct.Position.Height > TargetPosition.Height + Hysteresis THEN
		ShutterAct.Close();
	ELSE
		// Then move to target angle
		IF ShutterAct.Position.Angle + Hysteresis < TargetPosition.Angle THEN
			ShutterAct.Open();
		ELSIF ShutterAct.Position.Angle > TargetPosition.Angle + Hysteresis THEN
			ShutterAct.Close();
		ELSE
			// Target Position and Angle achieved
			MovingToPosition := FALSE;
			ShutterAct.Stop();
		END_IF
	END_IF
END_IF

CurrentPosition := ShutterAct.Position;]]></ST>
    </Implementation>
    <Method Name="SetCommand" Id="{3d42c165-d268-469c-a969-e4963ab6a807}">
      <Declaration><![CDATA[METHOD PUBLIC SetCommand
VAR_INPUT
	NewCmd : stShutterCommand;
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.PreviousCommand := THIS^.CurrentCommand;
THIS^.CurrentCommand := NewCmd;
This^.NewCommandSet := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>