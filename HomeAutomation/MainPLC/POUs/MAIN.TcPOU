<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{b477ade9-5e41-44da-827a-03687596879d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	
	PlcFirstCycle : BOOL := TRUE;
	
	// SHUTTERS
	Shutter1Cmd : stShutterCommand;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*
IF PlcFirstCycle THEN
	
	PlcFirstCycle := FALSE;
END_IF

Shutter1Cmd.CommandType := eShutterCommandType.NONE;

// STOP condition - If shutter is moving, any switch R1 or R2 click will stop shutter
IF Shutter1.State.CurrentState <> eShutterStateType.IDLE AND 
	( SwitchR1Up.State.CurrentState <> eSwitchStateType.IDLE
	OR SwitchR1Down.State.CurrentState <> eSwitchStateType.IDLE) THEN
	Shutter1Cmd.CommandType := eShutterCommandType.STOP;

// OPEN condition
ELSIF SwitchR1Up.State.CurrentState = eSwitchStateType.MULTI_CLICK AND SwitchR1Up.State.PressCount = 2 THEN
	Shutter1Cmd.CommandType := eShutterCommandType.OPEN;

// Close condition
ELSIF SwitchR1Down.State.CurrentState = eSwitchStateType.MULTI_CLICK AND SwitchR1Down.State.PressCount = 2 THEN
	Shutter1Cmd.CommandType := eShutterCommandType.Close;

// STEP_OPEN condition
ELSIF SwitchR1Up.State.CurrentState = eSwitchStateType.SHORT_CLICK THEN
	Shutter1Cmd.CommandType := eShutterCommandType.STEP_OPEN;
	
// STEP_CLOSE condition
ELSIF SwitchR1Down.State.CurrentState = eSwitchStateType.SHORT_CLICK THEN
	Shutter1Cmd.CommandType := eShutterCommandType.STEP_CLOSE;
	
// MOVE_TO_POSITION condition
ELSIF SwitchR1Up.State.CurrentState = eSwitchStateType.LONG_CLICK
	OR SwitchR1Down.State.CurrentState = eSwitchStateType.LONG_CLICK THEN
	Shutter1Cmd.Position := 50;
	Shutter1Cmd.Angle := 50;
	Shutter1Cmd.CommandType := eShutterCommandType.MOVE_TO_POSITION;
END_IF

Shutter1(Command := Shutter1Cmd, Config := Shutter1Config);

gvlShutters.gvShutter1Up := Shutter1.Q_Open;
gvlShutters.gvShutter1Down := Shutter1.Q_MoveDown;

*)]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>