<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{b477ade9-5e41-44da-827a-03687596879d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	
	PlcFirstCycle : BOOL := TRUE;
	
	// SHUTTERS
	Shutter1Switch : fbShutterCmdSourceSwitch;
	Shutter1SafetyCmd : stShutterCommand;
	Shutter1SafetyCmdExecute : BOOL := FALSE;
	Shutter1Arbiter : fbShutterCmdArbiter;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
IF PlcFirstCycle THEN
	
	PlcFirstCycle := FALSE;
END_IF

gvlSwitches.SwitchR1Open();
gvlSwitches.SwitchR1Close();
gvlSwitches.SwitchR1OpenCtrl();
gvlSwitches.SwitchR1CloseCtrl();

Shutter1Switch(OpenSwitchState := gvlSwitches.SwitchR1OpenCtrl.CurrentSwitchState,
				CloseSwitchState := gvlSwitches.SwitchR1CloseCtrl.CurrentSwitchState,
				ShutterStateType := gvlShutters.ShutterR1Act.CurrentStateType);
				
Shutter1Arbiter(SwitchCmd := Shutter1Switch.Cmd,
				SwitchNewCmd := Shutter1Switch.NewCmd,
				AutoCmd := gvlHA.Shutter1Cmd,
				AutoNewCmd := gvlHA.Shutter1CmdExecute,
				SafetyCmd := Shutter1SafetyCmd,
				SafetyNewCmd := Shutter1SafetyCmdExecute);
				
IF Shutter1Arbiter.NewCmd THEN
	gvlShutters.ShutterR1Ctrl.SetCommand(NewCmd := Shutter1Arbiter.Cmd);
END_IF

// Execute shutter logic
gvlShutters.ShutterR1Ctrl();
gvlShutters.ShutterR1Act();
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>