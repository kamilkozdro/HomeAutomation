<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{b477ade9-5e41-44da-827a-03687596879d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	
	PlcFirstCycle : BOOL := TRUE;

	// SWITCHES
	Switch1State : stSwitchState;
	Switch1Config : stSwitchConfig;
	
	// SWITCH CONTROLLERS
	Switch1Ctrl : fbSwitchController;
	
	// SHUTTERS
	Shutter1State : stShutterState;
	Shutter1Config : stShutterConfig;
	Shutter1Command : stShutterCommand;
	
	// SHUTTER CONTROLLERS
	Shutter1Ctrl : fbShutterController;
	
	
	// Test

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
Switch1Config.Input := gvlSwitches.gvSwitchH1;

IF PlcFirstCycle THEN
	Switch1Config.ShortClickMaxTime := T#500MS;
	Switch1Config.ShortClickDelayTime := T#500MS;
	Switch1Config.LongClickMaxTime := T#1500MS;
	Shutter1Config.TravelTime := T#20S;
	PlcFirstCycle := FALSE;
END_IF


Switch1Ctrl(Config := Switch1Config);
Switch1State := Switch1Ctrl.State;

// CASE Switch1State.CurrentState OF
// 	eSwitchStateType.HOLD:
// 		Shutter1Command.CommandType := eShutterCommandType.OPEN;
// 	eSwitchStateType.LONG_CLICK:
// 		Shutter1Command.CommandType := eShutterCommandType.MOVE_TO_POSITION;
// 		Shutter1Command.Position := 100;
// 	eSwitchStateType.SHORT_CLICK:
// 		Shutter1Command.CommandType := eShutterCommandType.STOP;
// END_CASE

Shutter1Ctrl(Config := Shutter1Config, Command := Shutter1Command);
Shutter1State := Shutter1Ctrl.State;


]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>