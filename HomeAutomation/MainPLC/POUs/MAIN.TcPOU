<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{b477ade9-5e41-44da-827a-03687596879d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	
	PlcFirstCycle : BOOL := TRUE;

	// SWITCHES
	Switch1Ctrl : fbSwitchController;
	Switch1Config : stSwitchConfig;
	
	// SHUTTER CONTROLLERS
	Shutter1Ctrl : fbShutterController;
	Shutter1Cmd : stShutterCommand;
	
	// SHUTTER ACTUATORS
	Shutter1Act : fbShutterActuator;
	Shutter1Config : stShutterConfig;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
Switch1Config.Input := gvlSwitches.gvSwitchH1;


IF PlcFirstCycle THEN
	Switch1Config.ShortClickMaxTime := T#500MS;
	Switch1Config.ShortClickDelayTime := T#500MS;
	Switch1Config.LongClickMaxTime := T#1500MS;
	Shutter1Config.TravelTime := T#20S;
	PlcFirstCycle := FALSE;
END_IF


Switch1Ctrl(Config := Switch1Config);

CASE Switch1Ctrl.State.CurrentState OF
	eSwitchStateType.SHORT_CLICK:
		Shutter1Cmd.CommandType := eShutterCommandType.STEP_OPEN;
	eSwitchStateType.LONG_CLICK:
		Shutter1Cmd.CommandType := eShutterCommandType.MOVE_TO_POSITION;
		Shutter1Cmd.Position := 50;
		Shutter1Cmd.Angle := 50;
	eSwitchStateType.MULTI_CLICK:
		CASE Switch1Ctrl.State.PressCount OF
			2:
				Shutter1Cmd.CommandType := eShutterCommandType.OPEN;		
		END_CASE
	eSwitchStateType.HOLD_ON:
	;
	eSwitchStateType.HOLD_OFF:
	;	
END_CASE


Shutter1Ctrl(Command := Shutter1Cmd, State := Shutter1Act.State);
Shutter1Act(MoveUp := Shutter1Ctrl.MoveUp, MoveDown := Shutter1Ctrl.MoveDown, Config := Shutter1Config);

GVL_Shutters.gvShutter1Up := Shutter1Act.Q_MoveUp;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>