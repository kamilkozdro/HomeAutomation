<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="gvlShutters" Id="{7a0c2c86-f13b-43d1-9cdd-d1f7080b47ea}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL PERSISTENT
	ShutterR1Config : stShutterConfig := (HeightTravelTime := T#15S,
										HeightTravelTimeOverstep := T#1S,
										AngleTravelTime := T#3S);
END_VAR

VAR_GLOBAL
	
	ShutterR1Act : fbShutterAct(OpenRelay := gvlRelays.Shutter1OpenRelay,
								CloseRelay := gvlRelays.Shutter1CloseRelay,
								Config := ShutterR1Config);
	ShutterR1Ctrl : fbShutterCtrl(ShutterActuator := ShutterR1Act);
	
	ShutterR1Switch : fbShutterCmdSourceSwitch := (OpenSwitchState := gvlSwitches.SwitchR1OpenCtrl.CurrentSwitchState,
													CloseSwitchState := gvlSwitches.SwitchR1CloseCtrl.CurrentSwitchState,
													ShutterStateType := gvlShutters.ShutterR1Act.CurrentStateType);
	
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>