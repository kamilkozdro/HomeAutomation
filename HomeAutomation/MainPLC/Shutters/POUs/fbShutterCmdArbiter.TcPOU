<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fbShutterCmdArbiter" Id="{98a9f71d-7fcf-4a1c-bcf5-1d227a612ce2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK fbShutterCmdArbiter
VAR_INPUT
    SwitchCmd     : stShutterCommand;
    SwitchNewCmd  : BOOL;

    AutoCmd       : stShutterCommand;
    AutoNewCmd    : BOOL;

    SafetyCmd     : stShutterCommand;
    SafetyNewCmd  : BOOL;
END_VAR
VAR_OUTPUT
    Cmd           : stShutterCommand;
    NewCmd        : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Cmd.CommandType := eShutterCommandType.NONE;
Cmd.Position.Height := 0;
Cmd.Position.Angle := 0;
NewCmd := FALSE;

// Highest priority: Safety
IF SafetyNewCmd THEN
    Cmd := SafetyCmd;
    NewCmd := TRUE;

// Next priority: manual switch
ELSIF SwitchNewCmd THEN
    Cmd := SwitchCmd;
    NewCmd := TRUE;

// Lowest priority: automatic
ELSIF AutoNewCmd THEN
    Cmd := AutoCmd;
    NewCmd := TRUE;
END_IF;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>