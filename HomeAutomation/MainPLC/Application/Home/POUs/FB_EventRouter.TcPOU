<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_EventRouter" Id="{C3C3C3C3-C3C3-43C3-83C3-C3C3C3C3C3C0}">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_EventRouter
VAR_INPUT
    bShortClick      : BOOL;
    nShortClickCount : USINT;
    iLight           : I_Light;
END_VAR
VAR_OUTPUT
    bToggleExecuted  : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Route a single short-click event to the configured light.
bToggleExecuted := FALSE;

IF bShortClick AND (nShortClickCount = 1) THEN
    iLight.Toggle();
    bToggleExecuted := TRUE;
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
