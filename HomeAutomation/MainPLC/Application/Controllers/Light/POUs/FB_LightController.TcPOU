<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_LightController" Id="{C51D8A20-3F74-4D19-9A62-5B7C8D9E1001}">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LightController
VAR_INPUT
    stSwitchControlData : ST_SwitchControlData;
    nLightCount      : USINT;
END_VAR
VAR_IN_OUT
    aLights          : ARRAY[1..10] OF I_Light;
END_VAR
VAR
    nIndex           : USINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// A single short click toggles every light assigned to this controller.
// Other click patterns are intentionally ignored by this initial implementation.
IF stSwitchControlData.bShortClick
    AND (stSwitchControlData.nShortClickCount = 1) THEN
    FOR nIndex := 1 TO 10 DO
        IF nIndex <= nLightCount THEN
            aLights[nIndex].Toggle();
        END_IF
    END_FOR
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
