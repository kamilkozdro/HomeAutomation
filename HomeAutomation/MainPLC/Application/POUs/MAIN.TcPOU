<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="MAIN" Id="{99999999-9999-4999-8999-999999999999}">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    // Temporary logical I/O variables. Map these to physical terminals in the I/O configuration.
    bSwitchInput : BOOL;
    bRelayOutput : BOOL;

    stSwitchId : ST_DeviceId;
    stRelayId  : ST_DeviceId;
    stLightId  : ST_DeviceId;

    fbSwitch           : FB_SwitchMonostable;
    fbSwitchController : FB_SwitchController;
    fbRelay            : FB_RelayMonostable;
    fbLight            : FB_Light;
    fbLightController  : FB_LightController;

    nSwitchInputCount : USINT := 1;
    nRuleCount        : USINT := 2;
    nLightCount       : USINT := 1;
    nGroupCount       : USINT := 1;

    aSwitchInputs : ARRAY[1..10] OF ST_SwitchControlInput;
    aLightRules   : ARRAY[1..50] OF ST_LightControlRule;
    aLights       : ARRAY[1..20] OF I_Light;
    aLightGroups  : ARRAY[1..10] OF ST_LightGroup;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Device identities.
stSwitchId.sId := 1;
stSwitchId.sName := 'Wall Switch';
stSwitchId.sRoom := 'Living Room';

stRelayId.sId := 2;
stRelayId.sName := 'Light Relay';
stRelayId.sRoom := 'Living Room';

stLightId.sId := 3;
stLightId.sName := 'Ceiling Light';
stLightId.sRoom := 'Living Room';

// 1. Read the physical/logical switch input.
fbSwitch(
    stDeviceId := stSwitchId,
    bInput := bSwitchInput
);

// 2. Interpret switch transitions and generate event data.
fbSwitchController(
    iSwitch := fbSwitch
);

// 3. Compose the light with its relay.
fbLight(
    stDeviceId := stLightId,
    iRelay := fbRelay
);

// 4. Register devices and publish the switch event input.
aLights[1] := fbLight;
aSwitchInputs[1].nSwitchId := stSwitchId.sId;
aSwitchInputs[1].stControlData := fbSwitchController.stControlData;

// 5. Configure static event-to-action rules.
// One short click toggles the ceiling light.
aLightRules[1].nSwitchId := stSwitchId.sId;
aLightRules[1].eEvent := E_SwitchEventType.ShortClick;
aLightRules[1].nShortClickCount := 1;
aLightRules[1].eTargetType := E_LightTargetType.Light;
aLightRules[1].nTargetId := stLightId.sId;
aLightRules[1].eAction := E_LightAction.Toggle;
aLightRules[1].bEnabled := TRUE;

// Four short clicks turn off every light in the AllLights group.
aLightRules[2].nSwitchId := stSwitchId.sId;
aLightRules[2].eEvent := E_SwitchEventType.ShortClick;
aLightRules[2].nShortClickCount := 4;
aLightRules[2].eTargetType := E_LightTargetType.Group;
aLightRules[2].nTargetId := 1;
aLightRules[2].eAction := E_LightAction.TurnOff;
aLightRules[2].bEnabled := TRUE;

// Static group membership. The example group currently contains one light.
aLightGroups[1].nGroupId := 1;
aLightGroups[1].nLightCount := 1;
aLightGroups[1].aLightIds[1] := stLightId.sId;

// 6. Match events against rules and execute actions on their targets.
fbLightController(
    nSwitchInputCount := nSwitchInputCount,
    nRuleCount := nRuleCount,
    nLightCount := nLightCount,
    nGroupCount := nGroupCount,
    aSwitchInputs := aSwitchInputs,
    aRules := aLightRules,
    aLights := aLights,
    aGroups := aLightGroups
);

// 7. Execute the relay FB after controller commands so its output is updated in this scan.
fbRelay(
    stDeviceId := stRelayId
);

// Temporary logical output. Map bRelayOutput to a physical output terminal.
bRelayOutput := fbRelay.bOutput;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
