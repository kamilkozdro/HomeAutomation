<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="MAIN" Id="{99999999-9999-4999-8999-999999999999}">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    // Temporary logical I/O variables. Map these to physical terminals in the I/O configuration.
    bCeilingSwitchInput : BOOL;
    bWallSwitchInput    : BOOL;
    bAmbientSwitchInput : BOOL;

    bCeilingLightOutput : BOOL;
    bWallLightOutput    : BOOL;
    bAmbientLightOutput : BOOL;

    fbLivingRoom : FB_LivingRoom;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// The room FB owns its switches, lights, relays and room-level behavior.
fbLivingRoom(
    bCeilingSwitchInput := bCeilingSwitchInput,
    bWallSwitchInput := bWallSwitchInput,
    bAmbientSwitchInput := bAmbientSwitchInput,
    bCeilingLightOutput => bCeilingLightOutput,
    bWallLightOutput => bWallLightOutput,
    bAmbientLightOutput => bAmbientLightOutput
);

// Map the logical input/output variables to physical terminals in the I/O configuration.
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
