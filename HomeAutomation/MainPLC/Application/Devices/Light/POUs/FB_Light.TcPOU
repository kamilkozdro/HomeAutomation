<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_Light" Id="{B2B2B2B2-B2B2-42B2-82B2-B2B2B2B2B2B0}">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Light IMPLEMENTS I_Light
VAR_INPUT
    stDeviceId : ST_DeviceId;
    iRelay     : I_Relay;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// FB_Light delegates relay operations through I_Relay.
]]></ST>
    </Implementation>
    <Property Name="DeviceId" Id="{B2B2B2B2-B2B2-42B2-82B2-B2B2B2B2B2B1}">
      <Declaration><![CDATA[PROPERTY DeviceId : ST_DeviceId
]]></Declaration>
      <Get Name="Get" Id="{B2B2B2B2-B2B2-42B2-82B2-B2B2B2B2B2B2}">
        <Declaration><![CDATA[
]]></Declaration>
        <Implementation>
          <ST><![CDATA[DeviceId := stDeviceId;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsOn" Id="{B2B2B2B2-B2B2-42B2-82B2-B2B2B2B2B2B3}">
      <Declaration><![CDATA[PROPERTY IsOn : BOOL
]]></Declaration>
      <Get Name="Get" Id="{B2B2B2B2-B2B2-42B2-82B2-B2B2B2B2B2B4}">
        <Declaration><![CDATA[
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsOn := iRelay.IsOn;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TurnOn" Id="{B2B2B2B2-B2B2-42B2-82B2-B2B2B2B2B2B5}">
      <Declaration><![CDATA[METHOD PUBLIC TurnOn
]]></Declaration>
      <Implementation>
        <ST><![CDATA[iRelay.TurnOn();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TurnOff" Id="{B2B2B2B2-B2B2-42B2-82B2-B2B2B2B2B2B6}">
      <Declaration><![CDATA[METHOD PUBLIC TurnOff
]]></Declaration>
      <Implementation>
        <ST><![CDATA[iRelay.TurnOff();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Toggle" Id="{B2B2B2B2-B2B2-42B2-82B2-B2B2B2B2B2B7}">
      <Declaration><![CDATA[METHOD PUBLIC Toggle
]]></Declaration>
      <Implementation>
        <ST><![CDATA[iRelay.Toggle();
]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetBrightness" Id="{B2B2B2B2-B2B2-42B2-82B2-B2B2B2B2B2B8}">
      <Declaration><![CDATA[METHOD PUBLIC SetBrightness
VAR_INPUT
    nBrightness : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// A relay-backed light supports only on/off switching.
// Zero switches it off; any non-zero level switches it on.
// A dimmer-backed light implementation can provide actual level control.
IF nBrightness = 0 THEN
    iRelay.TurnOff();
ELSE
    iRelay.TurnOn();
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
