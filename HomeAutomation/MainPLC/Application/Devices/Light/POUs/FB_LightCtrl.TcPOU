<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_LightCtrl" Id="{C51D8A20-3F74-4D19-9A62-5B7C8D9E1001}">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_LightCtrl
VAR_INPUT
    stLightCmd : ST_LightCmd;
    iLight     : I_Light;
END_VAR
VAR
    nBrightness : UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Commands are pulses generated by the room program.
// The controller executes the supplied action once when it is present.
CASE stLightCmd.eAction OF
    E_LightAction.Toggle:
        iLight.Toggle();

    E_LightAction.TurnOn:
        iLight.TurnOn();

    E_LightAction.TurnOff:
        iLight.TurnOff();

    E_LightAction.SetBrightness:
        // Keep the command value within the supported percentage range.
        nBrightness := MIN(stLightCmd.nBrightness, 100);
        iLight.SetBrightness(nBrightness);

    E_LightAction.None:
        // No command in this PLC cycle.
END_CASE
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
