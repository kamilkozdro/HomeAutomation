<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_RelayBistableToggle" Id="{88888888-8888-4888-8888-888888888880}">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_RelayBistableToggle IMPLEMENTS I_Relay
VAR_INPUT
    stDeviceId : ST_DeviceId;
END_VAR
VAR
    bRequestedState : BOOL;
    bCurrentState   : BOOL;
    bPulseToSet     : BOOL;
    fbTrigger       : R_TRIG;
    fbPulse         : TP;
END_VAR
VAR_OUTPUT
    bTogglePulse : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbTrigger(CLK := (bRequestedState <> bCurrentState) AND NOT fbPulse.Q);
fbPulse(IN := fbTrigger.Q, PT := T#100MS);

IF fbTrigger.Q THEN
    bCurrentState := bRequestedState;
END_IF

bTogglePulse := fbPulse.Q;
]]></ST>
    </Implementation>
    <Property Name="DeviceId" Id="{88888888-8888-4888-8888-888888888881}">
      <Declaration><![CDATA[PROPERTY DeviceId : ST_DeviceId
GET
END_GET
END_PROPERTY
]]></Declaration>
      <Get>
        <Implementation>
          <ST><![CDATA[DeviceId := stDeviceId;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsOn" Id="{88888888-8888-4888-8888-888888888882}">
      <Declaration><![CDATA[PROPERTY IsOn : BOOL
GET
END_GET
END_PROPERTY
]]></Declaration>
      <Get>
        <Implementation>
          <ST><![CDATA[IsOn := bCurrentState;
]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TurnOn" Id="{88888888-8888-4888-8888-888888888883}">
      <Declaration><![CDATA[METHOD PUBLIC TurnOn
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRequestedState := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TurnOff" Id="{88888888-8888-4888-8888-888888888884}">
      <Declaration><![CDATA[METHOD PUBLIC TurnOff
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRequestedState := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Toggle" Id="{88888888-8888-4888-8888-888888888885}">
      <Declaration><![CDATA[METHOD PUBLIC Toggle
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bRequestedState := NOT bRequestedState;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
