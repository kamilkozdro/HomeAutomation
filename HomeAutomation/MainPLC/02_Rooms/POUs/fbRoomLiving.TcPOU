	ShutterR1Act : fbShutterAct(OpenRelay := ShutterR1OpenRelay,
								CloseRelay := ShutterR1CloseRelay,
								Config := gvlShutters.ShutterR1Config);
								
	ShutterR1Ctrl : fbShutterCtrl(ShutterActuator := ShutterR1Act);
	ShutterR1CmdSwitch : fbShutterCmdSourceSwitch;

END_VAR]]></Declaration>
