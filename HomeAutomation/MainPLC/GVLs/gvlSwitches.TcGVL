<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="gvlSwitches" Id="{e769fc42-99e4-482c-9eed-c0cbd00c6def}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL PERSISTENT
	SwitchConfig : stSwitchConfig :=(ShortClickMaxTime := T#300MS,
									ShortClickDelayTime := T#400MS,
									LongClickMaxTime := T#1000MS);
END_VAR

VAR_GLOBAL

	
	
	SwitchR1Open : fbMonoSwitch;
	SwitchR1Close : fbMonoSwitch;
	
	SwitchR1OpenCtrl : fbMonoSwitchCtrl(SwitchR1Open, SwitchConfig);
	SwitchR1CloseCtrl : fbMonoSwitchCtrl(SwitchR1Close, SwitchConfig);
	
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>