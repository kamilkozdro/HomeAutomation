<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="gvlSwitches" Id="{e769fc42-99e4-482c-9eed-c0cbd00c6def}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL PERSISTENT
	SwitchConfig : stSwitchConfig :=(ShortClickMaxTime := T#300MS,
									ShortClickDelayTime := T#300MS,
									LongClickMaxTime := T#1000MS);
END_VAR

VAR_GLOBAL

	
	
	SwitchR1Up : fbMonoSwitch;
	SwitchR1Down : fbMonoSwitch;
	
	SwitchR1UpCtrl : fbMonoSwitchCtrl(SwitchR1Up, SwitchConfig);
	SwitchR1DownCtrl : fbMonoSwitchCtrl(SwitchR1Down, SwitchConfig);
	
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>