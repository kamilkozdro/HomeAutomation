<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fbBistableSingleCoilRelay" Id="{0fae3c70-2fb9-46ef-aed9-dd8518f75f14}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK fbBistableSingleCoilRelay IMPLEMENTS iRelay
VAR_OUTPUT
	RelayOutput AT %Q* : BOOL;
END_VAR
VAR
    PulseReq : BOOL;
    PulseTP : TP;
	
	ToggleVirtualStateTrig : R_TRIG;	
END_VAR
VAR CONSTANT
    PulseTime : TIME := T#200MS;
END_VAR
VAR RETAIN
	RelaySet : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="IsSet" Id="{6eb00f3d-c6aa-447e-be14-295ed0b97da3}">
      <Declaration><![CDATA[{warning 'Add property implementation'}
PROPERTY IsSet : BOOL
]]></Declaration>
      <Get Name="Get" Id="{8141aa7c-5d5a-4692-8792-e740038cfeb1}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsSet := RelaySet;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{a9ee56df-9b3e-4fd0-adec-58152da57428}">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF RelaySet THEN
	PulseReq := TRUE;	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Run" Id="{6c4f1e2d-5b6d-4b86-9c8f-d86396793c39}">
      <Declaration><![CDATA[METHOD Run
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* 
	NOTE:
	After power reset, state of the relay is unknown and RelaySet variable may keep wrong value. 
	If RelaySet doesn't reflect the actual, physical state of relay, methods Reset() and Set() will have reverse effect.
	
	POSSIBLE SOLUTIONS:
	- relay state feedback as physical input signal
	- additional variable/method to toggle RelaySet without changing physical output RelayOutput
		implemented ToggleVirtualState(Execute : BOOL)
*)

PulseTP(IN := PulseReq, PT := PulseTime);
RelayOutput := PulseTP.Q;

IF PulseReq AND PulseTP.Q THEN
	RelaySet := NOT RelaySet;
	PulseReq := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Set" Id="{e2e6b3f1-b1b7-4ef5-8c82-af292b3e5831}">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD Set
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT RelaySet THEN
	PulseReq := TRUE;	
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ToggleVirtualState" Id="{fce4026f-45b5-4475-b209-29bf29b1bc0f}">
      <Declaration><![CDATA[METHOD ToggleVirtualState
VAR_INPUT
    Execute : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*
	Do not call it conditionally ( inside IF )
	Works best when called every PLC cycle
*)


ToggleVirtualStateTrig(CLK := Execute);
IF ToggleVirtualStateTrig.Q THEN
	THIS^.RelaySet := NOT THIS^.RelaySet;
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>