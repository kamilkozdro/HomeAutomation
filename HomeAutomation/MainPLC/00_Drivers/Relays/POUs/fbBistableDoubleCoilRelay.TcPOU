<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="fbBistableDoubleCoilRelay" Id="{335a84c2-d420-4524-aa4e-8efe9b956cf1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK fbBistableDoubleCoilRelay IMPLEMENTS iRelay
VAR_OUTPUT
	RelaySetOutput AT %Q* : BOOL;
	RelayResetOutput AT %Q* : BOOL;
END_VAR
VAR
	CmdSet : BOOL;
    CmdReset : BOOL;
    SetPulseTP : TP;
    ResetPulseTP : TP;
END_VAR
VAR CONSTANT
    PulseTime : TIME := T#200MS;
END_VAR
VAR PERSISTENT
	RelaySet : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="IsSet" Id="{c31de52c-601a-4de2-9ac8-9f8bfedf0563}">
      <Declaration><![CDATA[{warning 'Add property implementation'}
PROPERTY IsSet : BOOL
]]></Declaration>
      <Get Name="Get" Id="{9d09fda1-2f39-4c3c-8790-750d752761be}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsSet := RelaySet;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Reset" Id="{cad43598-7528-4a0d-9bc6-4e05f8803093}">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CmdReset := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Run" Id="{08493ca8-6235-46e1-91fc-35951c84eded}">
      <Declaration><![CDATA[METHOD Run
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Interlock commands
IF CmdReset THEN
	CmdSet := FALSE;
	RelaySet := FALSE;
ELSIF CmdSet THEN
	CmdReset := FALSE;
	RelaySet := TRUE;
END_IF


SetPulseTP(IN := CmdSet, PT := PulseTime);
ResetPulseTP(IN := CmdReset, PT := PulseTime);

// Pulse physical outputs
RelaySetOutput := SetPulseTP.Q;
RelayResetOutput := ResetPulseTP.Q;

// Reset commands
CmdSet := FALSE;
CmdReset := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Set" Id="{276ef09e-4879-413f-bd8a-3a7e49269787}">
      <Declaration><![CDATA[{warning 'Add method implementation '}
METHOD Set
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CmdSet := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>