<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="stSchedulerConfig" Id="{aeae3e9c-d0cb-4152-8157-97631ae2679f}">
    <Declaration><![CDATA[TYPE stSchedulerConfig :
STRUCT
	WeekDays : ARRAY[1..7] OF BOOL;      // 1=Sunday ... 7=Saturday
    Months   : ARRAY[1..12] OF BOOL;     // 1=January ... 12=December
     Times    : ARRAY[1..6] OF TIME_OF_DAY := [
        TOD#00:00,
        TOD#00:00,
        TOD#00:00,
        TOD#00:00,
        TOD#00:00,
        TOD#00:00
    ];
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>